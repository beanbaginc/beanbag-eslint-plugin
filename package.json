{
    "name": "@beanbag/eslint-plugin",
    "version": "4.0.0",
    "description": "Configuration used for linting Beanbag JavaScript codebases.",
    "homepage": "https://github.com/beanbaginc/beanbag-eslint-plugin",
    "github": "https://github.com/beanbaginc/beanbag-eslint-plugin",
    "keywords": [
        "eslint",
        "eslintplugin",
        "javascript"
    ],
    "author": {
        "name": "Beanbag, Inc.",
        "email": "questions@beanbaginc.com",
        "url": "https://www.beanbaginc.com"
    },
    "license": "MIT",
    "main": "lib/index.js",
    "exports": {
        "import": {
            "types": "./lib/index.d.mts",
            "default": "./lib/esm/index.js"
        },
        "require": {
            "types": "./lib/index.d.ts",
            "default": "./lib/cjs/index.js"
        }
    },
    "type": "module",
    "files": [
        "LICENSE",
        "NEWS.md",
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rm -rf lib _build",
        "build": "tsc && rollup -c --bundleConfigAsCjs",
        "full-build": "npm run clean && npm run build",
        "lint": "eslint src"
    },
    "dependencies": {
        "@eslint/js": "^9.38.0",
        "@stylistic/eslint-plugin": "^5.5.0",
        "eslint-plugin-jasmine": "^4.2.2",
        "typescript-eslint": "^8.46.2",
        "globals": "^16.4.0"
    },
    "devDependencies": {
        "@beanbag/eslint-plugin": "file:",
        "@beanbag/frontend-buildkit": "^2.0.0",
        "eslint": "^9.38.0",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "eslint": "^9"
    }
}
